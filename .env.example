# Copy to `.env` (never commit it) to connect the shared island while developing locally.
# For the live GitHub Pages site, add the same two names as GitHub Actions *variables* instead
# (Settings → Secrets and variables → Actions → Variables).
#
# Both values are in Supabase → Project Settings → API (or the Connect dialog).
# Use the PUBLIC anon / publishable key only. NEVER the service-role or secret key.
# Row Level Security in supabase/setup.sql + supabase/upgrade.sql is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
